（表现为：手动添加的节点传不过去、排序在生成后回弹）。\n+ */\n+const hasUnsavedEdit = computed(() => {\n+  if (!outlineStore.outline_id) return false\n+  return nodesSignature() !== lastPersistedSignature.value\n+})\n+\n+/** 标记当前节点已与后端对齐 */\n+function markPersisted() {\n+  lastPersistedSignature.value = nodesSignature()\n+}\n+\n+/**\n+ * 保存会产出新版本，且后端 SaveOutlineVersion 把新版本状态置为 draft\n+ * （修改已确认大纲时旧版转 superseded，新版需重新确认）。\n+ * 前端不同步 status 会误判「仍已确认」，随后生成请求被 GetConfirmed 以 409 拒绝。\n+ */\n+function syncStatusFromSave(data) {\n+  if (data && data.status) outlineStore.status = data.status\n+}\n+\n+/** 落库保障：把本地编辑提交为后端新版本；无改动则跳过（避免无谓的版本链膨胀） */\n+async function persistIfDirty() {\n+  if (!outlineStore.outline_id || !hasUnsavedEdit.value) return false\n+  savingOutline.value = true\n+  try {\n+    const data = await outlineStore.saveVersion()\n+    syncStatusFromSave(data)\n+    markPersisted()\n+    return true\n+  } finally {\n+    savingOutline.value = false\n+  }\n+}\n+\n // 自动恢复\n if (props.autoRestore) {\n   outlineStore.restore()\n }\n+// 恢复的节点来自本地缓存，作为对齐基线；否则刚进页面就会误报「有未保存的修改」\n+markPersisted()\n \n // 若无大纲且有 intent，自动创建\n watch(\n@@ -352,6 +416,8 @@ async function handleGenerateOutline() {\n       evidence_packet: evidence,\n       markdown\n     })\n+    // 创建已落库（createOutline → POST /outlines），作为后续「未保存」判定的对齐基线\n+    markPersisted()\n     emit('outline-created', {\n       outline_id: outlineStore.outline_id,\n       outline_version: outlineStore.outline_version\n@@ -390,7 +456,10 @@ function removeKeyPoint(node, index) {\n \n async function handleSave() {\n   try {\n-    await outlineStore.saveVersion()\n+    const data = await outlineStore.saveVersion()\n+    // 后端保存产出新版本并重置为 draft，前端必须同步状态，否则后续生成被 409 拒绝\n+    syncStatusFromSave(data)\n+    markPersisted()\n   } catch (err) {\n     emit('error', err?.message || '保存大纲失败')\n   }\n@@ -398,7 +467,10 @@ async function handleSave() {\n \n async function handleConfirm() {\n   try {\n+    // 确认前先落库：确认会冻结该版本，未提交的本地编辑（新增节点 / 排序）将永远进不了生成链路\n+    await persistIfDirty()\n     await outlineStore.confirmOutline()\n+    markPersisted()\n   } catch (err) {\n     emit('error', err?.message || '确认大纲失败')\n   }\n@@ -420,10 +492,17 @@ async function handleSendRevise() {\n   }\n }\n \n-function handleApplyRevision() {\n+async function handleApplyRevision() {\n   outlineStore.applyRevision()\n   showReviseDialog.value = false\n   reviseMessage.value = ''\n+  // 采纳后立即落库：后端生成链路只认存储版本（GetConfirmed），\n+  // 不落库则修订结果只存在于 localStorage，大纲页刷新后即与后端分叉（表现为「AI 修订没加上节点」）。\n+  try {\n+    await persistIfDirty()\n+  } catch (err) {\n+    emit('error', err?.message || 'AI 修订落库失败，请点「保存大纲」重试')\n+  }\n }\n \n function handleCancelRevision() {\n@@ -431,6 +510,12 @@ function handleCancelRevision() {\n   showReviseDialog.value = false\n   reviseMessage.value = ''\n }\n+\n+/**\n+ * 向父页面（S3 工作台）暴露落库保障入口。\n+ * 父页面在切换阶段 / 启动生成前调用，避免绕过本组件按钮的路径把未落库编辑带进生成链路。\n+ */\n+defineExpose({ persistIfDirty, hasUnsavedEdit })\n </script>\n \n <style scoped>\n@@ -485,6 +570,18 @@ function handleCancelRevision() {\n   color: #dc2626;\n   font-size: 13px;\n }\n+.unsaved-bar {\n+  display: flex;\n+  align-items: center;\n+  justify-content: space-between;\n+  gap: 10px;\n+  padding: 8px 14px;\n+  background: #fff8e6;\n+  border: 1px solid #f6dfa8;\n+  border-radius: 8px;\n+  color: #7c4a15;\n+  font-size: 12px;\n+}\n \n /* 节点列表 */\n .nodes-list {\ndiff --git a/frontend/teacher/src/pages/S3StudioPage.vue b/frontend/teacher/src/pages/S3StudioPage.vue\nindex cc2bb8e..23eba66 100644\n--- a/frontend/teacher/src/pages/S3StudioPage.vue\n+++ b/frontend/teacher/src/pages/S3StudioPage.vue\n@@ -69,6 +69,7 @@\n       <!-- ==================== 大纲阶段 ==================== -->\n       <div v-if=\"currentPhase === 'outline'\" class=\"phase-panel\">\n         <OutlineEditor\n+          ref=\"outlineEditorRef\"\n           :session-id=\"intentStore.sessionId\"\n           :intent-id=\"intentStore.intentId\"\n           :intent-summary=\"intentStore.intentSummary\"\n@@ -322,6 +323,41 @@ const genError = ref(\"\");\n const generationPages = ref([]);\n const regeneratingPageId = ref(\"\");\n const previewFrameSrc = ref(\"\");\n+// 大纲编辑器实例——用于在启动生成前强制把本地编辑落库\n+const outlineEditorRef = ref(null);\n+\n+/**\n+ * 进入生成阶段前落库保障。\n+ *\n+ * 根因：后端 generation_handler.go:40 在 outline_confirmed 时用\n+ * GetConfirmed 读取「存储版本」的节点，并以其 Nodes 覆盖请求里的 req.OutlineNodes(D:49)。\n+ * 前端只把编辑写进 localStorage 而不落库时，本地新增/排序的节点在生成与页面管理阶段\n+ * 会静默消失（用户实测：手动添加节点内容无法传递到内容生成和页面管理）。\n+ */\n+async function ensureOutlinePersisted() {\n+  const editor = outlineEditorRef.value;\n+  if (!editor?.persistIfDirty) return false;\n+  try {\n+    const saved = await editor.persistIfDirty();\n+    if (saved && !outlineStore.isConfirmed) {\n+      // 后端 SaveOutlineVersion 把新版本置为 draft（规范 §2.3：confirmed 大纲被修改则旧版 superseded），\n+      // 必须重新确认，否则生成链路 GetConfirmed 会以「必须使用后端已确认的大纲版本」409 拒绝。\n+      await outlineStore.confirmOutline();\n+    }\n+    return saved;\n+  } catch (err) {\n+    handleError(\"大纲保存失败：\" + (err?.message || \"\"));\n+    return false;\n+  }\n+}\n+\n+// 离开大纲阶段前落库：编辑器随后被 v-if 卸载，ref 失效，\n+// 未落库的编辑届时无法再提交，只能带着旧节点进入内容生成。\n+watch(currentPhase, async (next, prev) => {\n+  if (prev === \"outline\" && next !== \"outline\") {\n+    await ensureOutlinePersisted();\n+  }\n+});\n \n // 是否有参考资料\n const hasEvidence = computed(() => {\n@@ -390,7 +426,14 @@ function handleOutlineConfirmed() {\n \n // 开始生成内容\n async function handleStartGeneration() {\n-  if (!outlineStore.outline_id || !outlineStore.isConfirmed) {\n+  if (!outlineStore.outline_id) {\n+    handleError(\"请先确认大纲\");\n+    return;\n+  }\n+  // 生成请求的 outline_version 必须指向「已落库且已确认」的版本，\n+  // 否则后端 GetConfirmed 读到的还是旧节点，本地编辑（新增节点 / 排序）会被覆盖丢弃。\n+  await ensureOutlinePersisted();\n+  if (!outlineStore.isConfirmed) {\n     handleError(\"请先确认大纲\");\n     return;\n   }\n"}],"patchSummary":"在隔离 worktree 中对两个范围文件应用修复，均属「让前端本地编辑真正落库，使后端生成链路拿到的是教师编辑后的版本」。\\n\\nfrontend/teacher/src/components/teacher/OutlineEditor.vue（+101/-x）：新增落库基线机制 lastPersistedSignature + nodesSignature() + hasUnsavedEdit 计算属性；markPersisted() 在 autoRestore 后与 createOutline 成功后建立/刷新基线（避免刚进页面误报未保存）；新增 syncStatusFromSave() 把后端返回的 status=draft 同步回前端（堵住保存后状态分叉导致的生成 409）；新增 persistIfDirty()，仅在确有改动时提交新版本以避免版本链膨胀；handleSave 改为同步 status 与基线；handleConfirm 改为先 persistIfDirty() 再 confirmOutline()（确认会冻结版本，未提交编辑否则永远进不了生成链路）；handleApplyRevision 改为 async 并在采纳 AI 修订后立即落库（修「AI 修订加了节点但大纲页看不到/传不过去」）；模板新增未落库提示条与 .unsaved-bar 样式；defineExpose({ persistIfDirty, hasUnsavedEdit }) 供父页面调用。\\n\\nfrontend/teacher/src/pages/S3StudioPage.vue（+45/-x）：OutlineEditor 挂 ref=\\\"outlineEditorRef\\\"；新增 outlineEditorRef 与 ensureOutlinePersisted()，保存后若状态不再是 confirmed 则自动重新确认（对应后端 SaveOutlineVersion 置 draft 的语义）；新增 watch(currentPhase)，在离开 outline 阶段前落库——该阶段模板用 v-if 控制，组件会被卸载导致 ref 失效、未落库编辑再也无法提交；handleStartGeneration 前置 ensureOutlinePersisted()，并把原来的 isConfirmed 前置校验移到落库之后。\\n\\n未修改范围外的 outlineStore.js：修复选择在组件层建立落库保障，不改 store 语义。未 commit（工单说明主会话收集 worktree diff）。","verification":{"command":"cd frontend/teacher && python (提取两 .vue 的 <script setup> 体) -> node --check <tmp>.mjs","status":"passed","scope":"targeted","exitCode":0,"passed":2,"failed":0,"skipped":0},"changedFiles":["frontend/teacher/src/components/teacher/OutlineEditor.vue","frontend/teacher/src/pages/S3StudioPage.vue"],"examinedFiles":["frontend/teacher/src/stores/outlineStore.js","frontend/teacher/src/components/teacher/OutlineRevisionDialog.vue","frontend/teacher/src/pages/S3StudioPage.vue","frontend/teacher/src/components/teacher/OutlineEditor.vue","frontend/teacher/package.json","frontend/teacher/vitest.config.js","backend/internal/service/outline_service.go","backend/internal/service/outline_service_test.go","backend/internal/service/ai_engine_client.go","backend/internal/handler/generation_handler.go","backend/internal/handler/outline_handler.go"],"risks":["运行时行为未经任何执行验证：node_modules 缺失、无 test script、bash 未跑 Go/Python/浏览器端到端，所有功能性结论均为静态推断","范围两文件与 outlineStore.js 无测试覆盖（vitest include 不含 components/pages），改动内容恰