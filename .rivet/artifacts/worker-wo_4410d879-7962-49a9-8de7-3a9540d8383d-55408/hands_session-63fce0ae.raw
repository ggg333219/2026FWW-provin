+  outline: none;
+  font-family: inherit;
+  box-sizing: border-box;
+  background: #fafcfa;
+}
+.node-summary-input:focus { border-color: #5ca68f; }
+.node-summary { font-size: 12px; color: #475569; margin: 0; line-height: 1.5; }
+
+/* 知识点 */
+.node-key-points {
+  display: flex;
+  align-items: flex-start;
