+}
+.kp-tag-static {
+  font-size: 11px;
+  background: #e8f5f0;
+  color: #2f605a;
+  padding: 2px 8px;
+  border-radius: 999px;
+}
+
+/* 互动规划 */
+.node-interactive-plan {
+  border-top: 1px dashed #c6ded6;
+  padding-top: 8px;
+}
+.plan-toggle {
+  font-size: 12px;
+  color: #5ca68f;
+  cursor: pointer;
+  user-select: none;
+  list-style: none;
+}
+.plan-toggle::-webkit-details-marker { display: none; }
+.plan-fields {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  margin-top: 8px;
+}
+.plan-fields label {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 11px;
+  color: #64748b;
+}
+.plan-fields input[type="number"] {
+  width: 54px;
+  padding: 2px 5px;
+  border: 1px solid #c6ded6;
+  border-radius: 5px;
+  font-size: 11px;
+  outline: none;
+}
+.plan-fields select {
+  font-size: 11px;
+  border: 1px solid #c6ded6;
+  border-radius: 5px;
+  padding: 2px 4px;
+  outline: none;
+}
+.plan-fields input[type="checkbox"] { width: 14px; height: 14px; }
+
+/* 底部：时长 & 删除 */
+.node-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+}
+.duration-label {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  font-size: 11px;
+  color: #64748b;
+}
+.duration-input {
+  width: 48px;
+  padding: 2px 6px;
+  border: 1px solid #c6ded6;
+  border-radius: 5px;
+  font-size: 11px;
+  text-align: center;
+  outline: none;
+}
+.duration-input:disabled { background: #f8fbf9; }
+.node-delete-btn {
+  background: none;
+  border: none;
+  cursor: pointer;
+  font-size: 14px;
+  opacity: 0.4;
+  transition: opacity 0.15s;
+}
+.node-delete-btn:hover { opacity: 1; }
+
+/* 添加节点 */
+.add-node-row {
+  display: flex;
+  gap: 10px;
+  justify-content: center;
+  padding: 10px 0;
+}
+.add-node-btn {
+  font-size: 13px;
+}
+.btn {
+  padding: 6px 14px;
+  border-radius: 8px;
+  cursor: pointer;
+  font-size: 13px;
+  font-weight: 500;
+  transition: all 0.15s;
+  border: 1px solid transparent;
+}
+.btn-sm { padding: 5px 12px; font-size: 12px; }
+.btn-outline {
+  background: #fff;
+  border-color: #c6ded6;
+  color: #2f605a;
+}
+.btn-outline:hover { background: #f0f5f2; }
+.btn-primary {
+  background: #2f605a;
+  color: #fff;
+  border-color: #2f605a;
+}
+.btn-primary:hover:not(:disabled) { background: #1e4a44; }
+.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
+.btn:disabled { opacity: 0.5; cursor: not-allowed; }
+
+/* 修订输入条 */
+.revise-input-bar {
+  display: flex;
+  gap: 8px;
+  align-items: center;
+  padding: 10px 14px;
+  background: #f0f5f2;
+  border: 1px solid #c6ded6;
+  border-radius: 10px;
+}
+.revise-text-input {
+  flex: 1;
+  padding: 6px 10px;
+  border: 1px solid #c6ded6;
+  border-radius: 8px;
+  font-size: 13px;
+  outline: none;
+}
+.revise-text-input:focus { border-color: #5ca68f; }
+
+/* 过渡动画 */
+.node-list-enter-active,
+.node-list-leave-active { transition: all 0.25s ease; }
+.node-list-enter-from { opacity: 0; transform: translateY(-8px); }
+.node-list-leave-to { opacity: 0; transform: translateX(-8px); }
+</style>
