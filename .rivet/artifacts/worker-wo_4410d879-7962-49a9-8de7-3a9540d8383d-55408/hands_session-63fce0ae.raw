+  padding: 3px 6px;
+  color: #2f605a;
+  background: #f0f5f2;
+  cursor: pointer;
+}
+.node-type-badge {
+  font-size: 11px;
+  background: #e2ece6;
+  color: #5ca68f;
+  padding: 2px 8px;
+  border-radius: 999px;
+}
+.node-title-input {
+  flex: 1;
+  font-size: 14px;
+  font-weight: 600;
+  border: none;
+  border-bottom: 1.5px solid #c6ded6;
+  padding: 2px 4px;
+  outline: none;
+  color: #1e293b;
+  background: transparent;
+  min-width: 0;
+}
+.node-title-input:focus { border-bottom-color: #5ca68f; }
+.node-title { font-size: 14px; font-weight: 600; color: #1e293b; }
+.node-summary-input {
+  width: 100%;
+  font-size: 12px;
+  color: #475569;
+  border: 1px solid #c6ded6;
+  border-radius: 8px;
+  padding: 6px 8px;
+  resize: vertical;
+  outline: none;
+  font-family: inherit;
+  box-sizing: border-box;
+  background: #fafcfa;
+}
+.node-summary-input:focus { border-color: #5ca68f; }
+.node-summary { font-size: 12px; color: #475569; margin: 0; line-height: 1.5; }
+
+/* 知识点 */
+.node-key-points {
+  display: flex;
+  align-items: flex-start;
+  gap: 6px;
+  flex-wrap: wrap;
+}
+.kp-label { font-size: 11px; color: #94a3b8; white-space: nowrap; line-height: 22px; }
+.kp-tags { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
+.kp-tag {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 11px;
+  background: #e8f5f0;
+  color: #2f605a;
+  padding: 2px 8px;
