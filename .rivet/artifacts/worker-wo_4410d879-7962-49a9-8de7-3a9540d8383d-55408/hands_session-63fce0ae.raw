+  font-size: 10px;
+  color: #5ca68f;
+  cursor: pointer;
+  padding: 1px 4px;
+  line-height: 1;
+}
+.move-btn:disabled { opacity: 0.35; cursor: not-allowed; }
+
+/* 节点内容 */
+.node-content {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.node-top-row {
+  display: flex;
