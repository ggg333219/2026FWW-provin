+
+/* 过渡动画 */
+.node-list-enter-active,
+.node-list-leave-active { transition: all 0.25s ease; }
+.node-list-enter-from { opacity: 0; transform: translateY(-8px); }
+.node-list-leave-to { opacity: 0; transform: translateX(-8px); }
+</style>
