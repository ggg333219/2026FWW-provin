+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 10px;
+  padding: 12px 16px;
+  background: #f8fbf9;
+  border: 1px solid #e2ece6;
+  border-radius: 12px;
+}
+.outline-meta {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  font-size: 12px;
+  color: #607a71;
+  flex-wrap: wrap;
+}
+.outline-status {
+  font-weight: 600;
+  padding: 2px 8px;
+  border-radius: 999px;
+}
+.status-draft { background: #f0f5f2; color: #2f605a; }
+.status-confirming { background: #fff8e6; color: #7c4a15; }
+.status-confirmed { background: #d1fae5; color: #065f46; }
+.status-superseded { background: #f3f4f6; color: #6b7280; }
+.outline-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+/* 错误条 */
+.error-bar {
+  padding: 10px 14px;
+  background: #fef2f2;
+  border: 1px solid #fecaca;
+  border-radius: 8px;
+  color: #dc2626;
+  font-size: 13px;
+}
+
+/* 节点列表 */
+.nodes-list {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.outline-node-card {
+  display: flex;
+  gap: 12px;
+  padding: 14px 16px;
+  background: #fff;
+  border: 1.5px solid #e2ece6;
+  border-radius: 14px;
+  transition: border-color 0.15s;
+}
+.outline-node-card:hover {
+  border-color: #5ca68f;
+}
+.outline-node-card.node-type-section {
+  border-left: 4px solid #2f605a;
+  background: #f8fbf9;
+}
+.outline-node-card.node-type-quiz {
+  border-left: 4px solid #7c3aed;
+}
