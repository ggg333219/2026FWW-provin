+<template>
+  <div class="outline-editor">
+    <!-- 大纲头部信息 -->
+    <div class="outline-header">
+      <div class="outline-meta">
+        <span class="outline-id" v-if="outlineStore.outline_id">
+          大纲 ID：{{ outlineStore.outline_id }}
+        </span>
+        <span class="outline-version" v-if="outlineStore.outline_version">
+          v{{ outlineStore.outline_version }}
+        </span>
+        <span class="outline-status" :class="`status-${outlineStore.status}`">
+          {{ statusLabel }}
+        </span>
+        <span class="outline-duration">
+          ⏱ 总计 {{ outlineStore.totalDuration }} 分钟 · {{ outlineStore.nodeCount }} 个节点
+        </span>
+      </div>
+      <div class="outline-actions">
+        <button
+          v-if="outlineStore.canEdit"
+          class="btn btn-sm"
+          :disabled="outlineStore.reviseLoading"
+          @click="showReviseInput = true"
+          title="发送指令让 AI 修改大纲"
+        >
+          {{ outlineStore.reviseLoading ? 'AI 修订中...' : '🤖 AI 修订' }}
+        </button>
+        <button
+          v-if="outlineStore.canEdit"
+          class="btn btn-sm"
+          :disabled="outlineStore.loading"
+          @click="handleSave"
+        >
+          保存大纲
+        </button>
+        <button
+          v-if="outlineStore.isConfirmed"
+          class="btn btn-sm btn-primary"
+          @click="$emit('confirm-complete')"
+        >
+          进入内容生成 →
+        </button>
+        <button
+          v-else-if="outlineStore.canEdit && outlineStore.nodeCount > 0"
+          class="btn btn-sm btn-primary"
+          :disabled="outlineStore.loading"
+          @click="handleConfirm"
+        >
+          {{ outlineStore.loading ? '确认中...' : '确认大纲' }}
+        </button>
+      </div>
+    </div>
+
+    <!-- 错误提示 -->
+    <div v-if="outlineStore.error || outlineStore.confirmError" class="error-bar" role="alert">
+      {{ outlineStore.confirmError || outlineStore.error }}
+    </div>
+
+    <!-- 未落库提示：内容生成与页面管理读取的是后端存储版本，本地编辑不落库会丢失 -->
+    <div v-if="hasUnsavedEdit" class="unsaved-bar" role="status">
+      <span>
+        有未保存的修改（节点 / 排序 / 知识点）。确认大纲时会自动保存，确保这些改动能进入内容生成与页面管理。
+      </span>
+      <button
+        class="btn btn-sm"
+        :disabled="outlineStore.loading || savingOutline"
+        @click="handleSave"
+      >{{ savingOutline ? '保存中...' : '立即保存' }}</button>
+    </div>
+
+    <!-- 节点编辑器 -->
+    <div class="nodes-list">
+      <TransitionGroup name="node-list">
+        <div
+          v-for="(node, idx) in outlineStore.nodes"
+          :key="node.node_id"
+          class="outline-node-card"
+          :class="`node-type-${node.node_type}`"
+        >
+          <!-- 节点序号 & 移动按钮 -->
+          <div class="node-drag-handle">
+            <span class="node-order">{{ idx + 1 }}</span>
+            <div class="node-move-btns" v-if="outlineStore.canEdit">
+              <button
+                class="move-btn"
+                :disabled="idx === 0"
+                @click="outlineStore.moveNode(node.node_id, 'up')"
+                title="上移"
+              >↑</button>
+              <button
+                class="move-btn"
+                :disabled="idx === outlineStore.nodes.length - 1"
+                @click="outlineStore.moveNode(node.node_id, 'down')"
+                title="下移"
+              >↓</button>
+            </div>
+          </div>
+
+          <!-- 节点内容 -->
+          <div class="node-content">
+            <div class="node-top-row">
+              <!-- 节点类型选择 -->
+              <select
+                v-if="outlineStore.canEdit"
+                v-model="node.node_type"
+                class="node-type-select"
+                @change="outlineStore.updateNode(node.node_id, { node_type: node.node_type })"
+              >
+                <option value="content">📖 知识讲解</option>
+                <option value="section">📂 章节标题</option>
+                <option value="quiz">❓ 随堂测验</option>
+                <option value="interactive">🎮 互动环节</option>
+                <option value="summary">📋 总结回顾</option>
+              </select>
+              <span v-else class="node-type-badge">{{ node.node_type }}</span>
+
+              <!-- 标题 -->
+              <input
+                v-if="outlineStore.canEdit"
+                v-model="node.title"
+                class="node-title-input"
+                placeholder="节点标题"
+                @input="outlineStore.updateNode(node.node_id, { title: node.title })"
+              />
+              <div v-else class="node-title">{{ node.title }}</div>
+            </div>
+
+            <!-- 摘要 -->
+            <textarea
+              v-if="outlineStore.canEdit"
+              v-model="node.summary"
+              class="node-summary-input"
+              placeholder="节点摘要（简述本节点教学内容）"
+              rows="2"
+              @input="outlineStore.updateNode(node.node_id, { summary: node.summary })"
+            ></textarea>
+            <p v-else class="node-summary">{{ node.summary }}</p>
+
+            <!-- 核心知识点标签 -->
+            <div class="node-key-points">
+              <span class="kp-label">核心知识点：</span>
+              <template v-if="outlineStore.canEdit">
+                <div class="kp-tags">
+                  <span
+                    v-for="(kp, ki) in node.key_points"
+                    :key="ki"
+                    class="kp-tag"
+                  >
+                    {{ kp }}
+                    <button class="kp-remove" @click="removeKeyPoint(node, ki)">×</button>
+                  </span>
+                  <input
+                    v-model="newKeyPoints[node.node_id]"
+                    class="kp-add-input"
+                    placeholder="+ 添加知识点"
+                    @keyup.enter="addKeyPoint(node)"
+                  />
+                </div>
+              </template>
+              <template v-else>
+                <span v-for="(kp, ki) in node.key_points" :key="ki" class="kp-tag-static">
+                  {{ kp }}
+                </span>
+              </template>
+            </div>
+
+            <!-- 互动规划（仅 interactive / quiz 类型且有 plan 时显示）
+                 注意：必须判 interactive_plan 非空——后端/LLM 产出的交互节点该字段常为 null，
+                 直接访问 interactive_plan.x 会抛错并中断整个节点列表渲染。 -->
+            <div
+              v-if="(node.node_type === 'interactive' || node.node_type === 'quiz') && node.interactive_plan && outlineStore.canEdit"
+              class="node-interactive-plan"
+            >
+              <details>
+                <summary class="plan-toggle">🎯 互动规划</summary>
+                <div class="plan-fields">
+                  <label>
+                    时长（分钟）
+                    <input
+                      type="number"
+                      v-model.number="node.interactive_plan.duration_minutes"
+                      min="1"
+                      max="60"
+                      @change="outlineStore.updateNode(node.node_id, { interactive_plan: { ...node.interactive_plan } })"
+                    />
+                  </label>
+                  <label>
+                    题目数量
+                    <input
+                      type="number"
+                      v-model.number="node.interactive_plan.question_count"
+                      min="1"
+                      max="20"
+                      @change="outlineStore.updateNode(node.node_id, { interactive_plan: { ...node.interactive_plan } })"
+                    />
+                  </label>
+                  <label>
+                    自动判分
+                    <input
+                      type="checkbox"
+                      v-model="node.interactive_plan.auto_grading"
+                      @change="outlineStore.updateNode(node.node_id, { interactive_plan: { ...node.interactive_plan } })"
+                    />
+                  </label>
+                  <label>
+                    产出方式
+                    <select v-model="node.interactive_plan.delivery">
+                      <option value="html5_link">HTML5 链接</option>
+                      <option value="ppt_native">PPT 内嵌</option>
+                      <option value="standalone_html">独立 HTML</option>
+                    </select>
+                  </label>
+                </div>
+              </details>
+            </div>
+
+            <!-- 时长 -->
+            <div class="node-footer">
+              <label class="duration-label">
+                时长
+                <input
+                  type="number"
+                  v-model.number="node.estimated_duration_minutes"
+                  min="1"
+                  max="180"
+                  :disabled="!outlineStore.canEdit"
+                  class="duration-input"
+                  @change="outlineStore.updateNode(node.node_id, { estimated_duration_minutes: node.estimated_duration_minutes })"
+                />
+                分钟
+              </label>
+
+              <!-- 删除按钮 -->
+              <button
+                v-if="outlineStore.canEdit"
+                class="node-delete-btn"
+                @click="handleDeleteNode(node.node_id)"
+                title="删除节点"
+              >🗑</button>
+            </div>
+          </div>
+        </div>
+      </TransitionGroup>
+
+      <!-- 添加节点按钮 -->
+      <div v-if="outlineStore.canEdit" class="add-node-row">
+        <button class="btn btn-outline add-node-btn" @click="handleAddNode">
+          ＋ 添加节点
+        </button>
+        <button
+          v-if="outlineStore.nodes.length === 0"
+          class="btn btn-primary"
+          @click="handleGenerateOutline"
+          :disabled="outlineStore.loading"
+        >
+          {{ outlineStore.loading ? 'AI 生成中...' : '🤖 AI 生成大纲' }}
+        </button>
+      </div>
+    </div>
+
+    <!-- AI 修订对话框 -->
+    <OutlineRevisionDialog
+      :visible="showReviseDialog"
+      :loading="revisingDialogLoading"
+      :change-summary="outlineStore.changeSummary"
+      :pending-nodes="outlineStore.pendingRevision?.nodes || []"
+      @apply="handleApplyRevision"
+      @cancel="handleCancelRevision"
+    />
+
+    <!-- AI 修订输入弹窗 -->
+    <div v-if="showReviseDialog" class="dialog-overlay" style="display:none"><!-- 利用 OutlineRevisionDialog --></div>
+
+    <!-- 修订指令输入（集成在 OutlineRevisionDialog 之前） -->
+    <div v-if="showReviseInput" class="revise-input-bar">
+      <input
+        v-model="reviseMessage"
+        class="revise-text-input"
+        placeholder="例如：增加一个生活案例，把课堂练习放到快速排序之后"
+        @keyup.enter="handleSendRevise"
+        autofocus
+      />
+      <button class="btn btn-primary" @click="handleSendRevise" :disabled="!reviseMessage.trim()">
+        发送修订
+      </button>
+      <button class="btn btn-outline" @click="showReviseInput = false">取消</button>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { ref, computed, watch } from 'vue'
+import { useOutlineStore } from '../../stores/outlineStore'
+import OutlineRevisionDialog from './OutlineRevisionDialog.vue'
+
+const props = defineProps({
+  /** 所属 session_id（从 S1 透传） */
+  sessionId: { type: String, default: '' },
+  /** 所属 intent_id（从 S1 透传） */
+  intentId: { type: String, default: '' },
+  /** 教学意图摘要（用于创建大纲） */
+  intentSummary: { type: Object, default: null },
+  /** 是否自动尝试从 localStorage 恢复大纲 */
+  autoRestore: { type: Boolean, default: true }
+})
+
+const emit = defineEmits(['confirm-complete', 'outline-created', 'error'])
+
+const outlineStore = useOutlineStore()
+
+const showReviseDialog = ref(false)
+const showReviseInput = ref(false)
+const reviseMessage = ref('')
+const revisingDialogLoading = ref(false) // 对话框内 AI 正在生成修订
+const newKeyPoints = ref({}) // { [node_id]: input value }
+
+const statusLabel = computed(() => ({
+  draft: '草稿',
+  confirming: '确认中',
+  confirmed: '已确认',
+  superseded: '已替代'
+}[outlineStore.status] || outlineStore.status))
+
+// 自动恢复
+// 最近一次与后端对齐（创建 / 保存 / 确认）时的节点快照签名
+const lastPersistedSignature = ref('')
+const savingOutline = ref(false)
+
+/** 节点快照签名——用于判断是否存在未落库的本地编辑 */
+function nodesSignature() {
+  return JSON.stringify(outlineStore.nodes || [])
+}
+
+/**
+ * 是否存在未落库的本地编辑（排序 / 增删 / 改字段 / 采纳 AI 修订）。
+ * 根因：后端生成链路以「存储版本」的节点为准——
+ * generation_handler.go:40 GetConfirmed 取库中版本，:49 直接以其 Nodes 覆盖 req.OutlineNodes。
+ * 前端只写 localStorage 不落库时，本地编辑在内容生成与页面管理阶段被静默丢弃
+ * （表现为：手动添加的节点传不过去、排序在生成后回弹）。
+ */
+const hasUnsavedEdit = computed(() => {
+  if (!outlineStore.outline_id) return false
+  return nodesSignature() !== lastPersistedSignature.value
+})
+
+/** 标记当前节点已与后端对齐 */
+function markPersisted() {
+  lastPersistedSignature.value = nodesSignature()
+}
+
+/**
+ * 保存会产出新版本，且后端 SaveOutlineVersion 把新版本状态置为 draft
+ * （修改已确认大纲时旧版转 superseded，新版需重新确认）。
+ * 前端不同步 status 会误判「仍已确认」，随后生成请求被 GetConfirmed 以 409 拒绝。
+ */
+function syncStatusFromSave(data) {
+  if (data && data.status) outlineStore.status = data.status
+}
+
+/** 落库保障：把本地编辑提交为后端新版本；无改动则跳过（避免无谓的版本链膨胀） */
+async function persistIfDirty() {
+  if (!outlineStore.outline_id || !hasUnsavedEdit.value) return false
+  savingOutline.value = true
+  try {
+    const data = await outlineStore.saveVersion()
+    syncStatusFromSave(data)
+    markPersisted()
+    return true
+  } finally {
+    savingOutline.value = false
+  }
+}
+
+// 自动恢复
+if (props.autoRestore) {
+  outlineStore.restore()
+}
+// 恢复的节点来自本地缓存，作为对齐基线；否则刚进页面就会误报「有未保存的修改」
+markPersisted()
+}
+
+// 若无大纲且有 intent，自动创建
+watch(
+  () => [outlineStore.outline_id, outlineStore.nodes.length],
+  ([oid, nc]) => {
+    if (!oid && nc === 0 && props.intentSummary) {
+      handleGenerateOutline()
+    }
+  },
+  { immediate: true }
+)
+
+async function handleGenerateOutline() {
+  if (!props.sessionId) {
+    emit('error', '缺少 session_id，请先完成 S1 意图理解')
+    return
+  }
+  try {
+    // 尝试从 localStorage 读取证据包
+    let evidence = null
+    try {
+      const raw = window.localStorage.getItem('fuww_s2_evidence_packet')
+      if (raw) evidence = JSON.parse(raw)
+    } catch {}
+    // 尝试从 localStorage 读取 markdown 内容
+    let markdown = ''
+    try {
+      const m = window.localStorage.getItem('fuww_s2_markdown')
+      if (m) markdown = m
+    } catch {}
+
+    await outlineStore.createOutline({
+      session_id: props.sessionId,
+      intent_id: props.intentId,
+      intent: props.intentSummary || {},
+      evidence_packet: evidence,
+      markdown
+    })
+    // 创建已落库（createOutline → POST /outlines），作为后续「未保存」判定的对齐基线
+    markPersisted()
+    emit('outline-created', {
+      outline_id: outlineStore.outline_id,
+      outline_version: outlineStore.outline_version
+    })
+  } catch (err) {
+    emit('error', err?.message || '创建大纲失败')
+  }
+}
+
+function handleAddNode() {
+  const lastNodeId = outlineStore.nodes.at(-1)?.node_id || null
+  outlineStore.addNode(lastNodeId)
+}
+
+function handleDeleteNode(nodeId) {
+  if (outlineStore.nodes.length <= 1) {
+    emit('error', '大纲至少需要一个节点')
+    return
+  }
+  outlineStore.removeNode(nodeId)
+}
+
+function addKeyPoint(node) {
+  const val = (newKeyPoints.value[node.node_id] || '').trim()
+  if (!val) return
+  const kps = [...(node.key_points || []), val]
+  outlineStore.updateNode(node.node_id, { key_points: kps })
+  newKeyPoints.value[node.node_id] = ''
+}
+
+function removeKeyPoint(node, index) {
+  const kps = [...(node.key_points || [])]
+  kps.splice(index, 1)
+  outlineStore.updateNode(node.node_id, { key_points: kps })
+}
+
+async function handleSave() {
+  try {
+    const data = await outlineStore.saveVersion()
+    // 后端保存产出新版本并重置为 draft，前端必须同步状态，否则后续生成被 409 拒绝
+    syncStatusFromSave(data)
+    markPersisted()
+  } catch (err) {
+    emit('error', err?.message || '保存大纲失败')
+  }
+}
+
+async function handleConfirm() {
+  try {
+    // 确认前先落库：确认会冻结该版本，未提交的本地编辑（新增节点 / 排序）将永远进不了生成链路
+    await persistIfDirty()
+    await outlineStore.confirmOutline()
+    markPersisted()
+  } catch (err) {
+    emit('error', err?.message || '确认大纲失败')
+  }
+}
+
+async function handleSendRevise() {
+  const msg = reviseMessage.value.trim()
+  if (!msg) return
+  showReviseInput.value = false
+  showReviseDialog.value = true
+  revisingDialogLoading.value = true
+  try {
+    await outlineStore.reviseOutline(msg)
+  } catch (err) {
+    emit('error', err?.message || 'AI 修订失败')
+    showReviseDialog.value = false
+  } finally {
+    revisingDialogLoading.value = false
+  }
+}
+
+async function handleApplyRevision() {
+  outlineStore.applyRevision()
+  showReviseDialog.value = false
+  reviseMessage.value = ''
+  // 采纳后立即落库：后端生成链路只认存储版本（GetConfirmed），
+  // 不落库则修订结果只存在于 localStorage，大纲页刷新后即与后端分叉（表现为「AI 修订没加上节点」）。
+  try {
+    await persistIfDirty()
+  } catch (err) {
+    emit('error', err?.message || 'AI 修订落库失败，请点「保存大纲」重试')
+  }
+}
+
+function handleCancelRevision() {
+  outlineStore.discardRevision()
+  showReviseDialog.value = false
+  reviseMessage.value = ''
+}
+</script>
+
+<style scoped>
+.outline-editor {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+/* 头部 */
+.outline-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 10px;
+  padding: 12px 16px;
+  background: #f8fbf9;
+  border: 1px solid #e2ece6;
+  border-radius: 12px;
+}
+.outline-meta {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  font-size: 12px;
+  color: #607a71;
+  flex-wrap: wrap;
+}
+.outline-status {
+  font-weight: 600;
+  padding: 2px 8px;
+  border-radius: 999px;
+}
+.status-draft { background: #f0f5f2; color: #2f605a; }
+.status-confirming { background: #fff8e6; color: #7c4a15; }
+.status-confirmed { background: #d1fae5; color: #065f46; }
+.status-superseded { background: #f3f4f6; color: #6b7280; }
+.outline-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+/* 错误条 */
+.error-bar {
+  padding: 10px 14px;
+  background: #fef2f2;
+  border: 1px solid #fecaca;
+  border-radius: 8px;
+  color: #dc2626;
+  font-size: 13px;
+}
+.unsaved-bar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 8px 14px;
+  background: #fff8e6;
+  border: 1px solid #f6dfa8;
+  border-radius: 8px;
+  color: #7c4a15;
+  font-size: 12px;
+}
+
+/* 节点列表 */
+.nodes-list {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.outline-node-card {
+  display: flex;
+  gap: 12px;
+  padding: 14px 16px;
+  background: #fff;
+  border: 1.5px solid #e2ece6;
+  border-radius: 14px;
+  transition: border-color 0.15s;
+}
+.outline-node-card:hover {
+  border-color: #5ca68f;
+}
+.outline-node-card.node-type-section {
+  border-left: 4px solid #2f605a;
+  background: #f8fbf9;
+}
+.outline-node-card.node-type-quiz {
+  border-left: 4px solid #7c3aed;
+}
+.outline-node-card.node-type-interactive {
+  border-left: 4px solid #ea580c;
+}
+.outline-node-card.node-type-summary {
+  border-left: 4px solid #ca8a04;
+}
+
+/* 序号 */
+.node-drag-handle {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 4px;
+  min-width: 28px;
+}
+.node-order {
+  font-size: 16px;
+  font-weight: 700;
+  color: #5ca68f;
+  line-height: 1;
+}
+.node-move-btns {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+.move-btn {
+  background: none;
+  border: 1px solid #c6ded6;
+  border-radius: 4px;
+  font-size: 10px;
+  color: #5ca68f;
+  cursor: pointer;
+  padding: 1px 4px;
+  line-height: 1;
+}
+.move-btn:disabled { opacity: 0.35; cursor: not-allowed; }
+
+/* 节点内容 */
+.node-content {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.node-top-row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+}
+.node-type-select {
+  font-size: 12px;
+  border: 1px solid #c6ded6;
+  border-radius: 6px;
+  padding: 3px 6px;
+  color: #2f605a;
+  background: #f0f5f2;
+  cursor: pointer;
+}
+.node-type-badge {
+  font-size: 11px;
+  background: #e2ece6;
+  color: #5ca68f;
+  padding: 2px 8px;
+  border-radius: 999px;
+}
+.node-title-input {
+  flex: 1;
+  font-size: 14px;
+  font-weight: 600;
+  border: none;
+  border-bottom: 1.5px solid #c6ded6;
+  padding: 2px 4px;
+  outline: none;
+  color: #1e293b;
+  background: transparent;
+  min-width: 0;
+}
+.node-title-input:focus { border-bottom-color: #5ca68f; }
+.node-title { font-size: 14px; font-weight: 600; color: #1e293b; }
+.node-summary-input {
+  width: 100%;
+  font-size: 12px;
+  color: #475569;
+  border: 1px solid #c6ded6;
+  border-radius: 8px;
+  padding: 6px 8px;
+  resize: vertical;
+  outline: none;
+  font-family: inherit;
+  box-sizing: border-box;
+  background: #fafcfa;
+}
+.node-summary-input:focus { border-color: #5ca68f; }
+.node-summary { font-size: 12px; color: #475569; margin: 0; line-height: 1.5; }
+
+/* 知识点 */
+.node-key-points {
+  display: flex;
+  align-items: flex-start;
+  gap: 6px;
+  flex-wrap: wrap;
+}
+.kp-label { font-size: 11px; color: #94a3b8; white-space: nowrap; line-height: 22px; }
+.kp-tags { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
+.kp-tag {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 11px;
+  background: #e8f5f0;
+  color: #2f605a;
+  padding: 2px 8px;
+  border-radius: 999px;
+}
+.kp-remove {
+  background: none;
+  border: none;
+  color: #2f605a;
+  cursor: pointer;
+  font-size: 12px;
+  padding: 0;
+  line-height: 1;
+  opacity: 0.6;
+}
+.kp-remove:hover { opacity: 1; }
+.kp-add-input {
+  font-size: 11px;
+  border: none;
+  background: transparent;
+  outline: none;
+  color: #2f605a;
+  width: 100px;
+  padding: 2px 4px;
+}
+.kp-tag-static {
+  font-size: 11px;
+  background: #e8f5f0;
+  color: #2f605a;
+  padding: 2px 8px;
+  border-radius: 999px;
+}
+
+/* 互动规划 */
+.node-interactive-plan {
+  border-top: 1px dashed #c6ded6;
+  padding-top: 8px;
+}
+.plan-toggle {
+  font-size: 12px;
+  color: #5ca68f;
+  cursor: pointer;
+  user-select: none;
+  list-style: none;
+}
+.plan-toggle::-webkit-details-marker { display: none; }
+.plan-fields {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  margin-top: 8px;
+}
+.plan-fields label {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 11px;
+  color: #64748b;
+}
+.plan-fields input[type="number"] {
+  width: 54px;
+  padding: 2px 5px;
+  border: 1px solid #c6ded6;
+  border-radius: 5px;
+  font-size: 11px;
+  outline: none;
+}
+.plan-fields select {
+  font-size: 11px;
+  border: 1px solid #c6ded6;
+  border-radius: 5px;
+  padding: 2px 4px;
+  outline: none;
+}
+.plan-fields input[type="checkbox"] { width: 14px; height: 14px; }
+
+/* 底部：时长 & 删除 */
+.node-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+}
+.duration-label {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  font-size: 11px;
+  color: #64748b;
+}
+.duration-input {
+  width: 48px;
+  padding: 2px 6px;
+  border: 1px solid #c6ded6;
+  border-radius: 5px;
+  font-size: 11px;
+  text-align: center;
+  outline: none;
+}
+.duration-input:disabled { background: #f8fbf9; }
+.node-delete-btn {
+  background: none;
+  border: none;
+  cursor: pointer;
+  font-size: 14px;
+  opacity: 0.4;
+  transition: opacity 0.15s;
+}
+.node-delete-btn:hover { opacity: 1; }
+
+/* 添加节点 */
+.add-node-row {
+  display: flex;
+  gap: 10px;
+  justify-content: center;
+  padding: 10px 0;
+}
+.add-node-btn {
+  font-size: 13px;
+}
+.btn {
+  padding: 6px 14px;
+  border-radius: 8px;
+  cursor: pointer;
+  font-size: 13px;
+  font-weight: 500;
+  transition: all 0.15s;
+  border: 1px solid transparent;
+}
+.btn-sm { padding: 5px 12px; font-size: 12px; }
+.btn-outline {
+  background: #fff;
+  border-color: #c6ded6;
+  color: #2f605a;
+}
+.btn-outline:hover { background: #f0f5f2; }
+.btn-primary {
+  background: #2f605a;
+  color: #fff;
+  border-color: #2f605a;
+}
+.btn-primary:hover:not(:disabled) { background: #1e4a44; }
+.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
+.btn:disabled { opacity: 0.5; cursor: not-allowed; }
+
+/* 修订输入条 */
+.revise-input-bar {
+  display: flex;
+  gap: 8px;
+  align-items: center;
+  padding: 10px 14px;
+  background: #f0f5f2;
+  border: 1px solid #c6ded6;
+  border-radius: 10px;
+}
+.revise-text-input {
+  flex: 1;
+  padding: 6px 10px;
+  border: 1px solid #c6ded6;
+  border-radius: 8px;
+  font-size: 13px;
+  outline: none;
+}
+.revise-text-input:focus { border-color: #5ca68f; }
+
+/* 过渡动画 */
+.node-list-enter-active,
+.node-list-leave-active { transition: all 0.25s ease; }
+.node-list-enter-from { opacity: 0; transform: translateY(-8px); }
+.node-list-leave-to { opacity: 0; transform: translateX(-8px); }
+</style>
diff --git a/.rivet/backups/1789137019152/frontend/teacher/src/pages/S3StudioPage.vue b/.rivet/backups/1789137019152/frontend/teacher/src/pages/S3StudioPage.vue
new file mode 100644
index 0000000..cc2bb8e
--- /dev/null
+++ b/.rivet/backups/1789137019152/frontend/teacher/src/pages/S3StudioPage.vue
@@ -0,0 +1,1085 @@
+<template>
+  <AppShell>
+    <div class="s3-page">
+      <!-- 页面头部 -->
+      <div class="page-header">
+        <div>
+          <h2>S3 课件生成</h2>
+          <p>大纲编辑 → 内容生成 → 页面预览</p>
+        </div>
+        <div class="page-header-right">
+          <div class="step-pills">
+            <router-link :to="{ name: 'S1Intent' }" class="pill"
+              >S1 意图</router-link
+            >
+            <router-link :to="{ name: 'S2Material' }" class="pill"
+              >S2 资料</router-link
+            >
+            <span class="pill active">S3 生成</span>
+            <router-link :to="{ name: 'S4Version' }" class="pill"
+              >S4 版本</router-link
+            >
+            <router-link :to="{ name: 'Middle' }" class="pill back-pill"
+              >返回中间页</router-link
+            >
+          </div>
+        </div>
+      </div>
+
+      <!-- 模式提示条 -->
+      <div
+        v-if="generationMode === 'without_evidence'"
+        class="evidence-warning"
+        role="status"
+      >
+        <div>
+          <strong>当前为无参考资料生成模式</strong>
+          <span>本次内容仅依据 S1 教学意图生成，不会伪造资料引用。</span>
+        </div>
+        <router-link :to="{ name: 'S2Material' }">返回补充资料</router-link>
+      </div>
+
+      <!-- S3 阶段指示器 -->
+      <div class="phase-tabs">
+        <button
+          class="phase-tab"
+          :class="{ active: currentPhase === 'outline' }"
+          @click="currentPhase = 'outline'"
+        >
+          📋 大纲编辑
+        </button>
+        <button
+          class="phase-tab"
+          :class="{ active: currentPhase === 'generating' }"
+          @click="currentPhase = 'generating'"
+          :disabled="!outlineStore.isConfirmed"
+        >
+          ⚙️ 内容生成
+        </button>
+        <button
+          class="phase-tab"
+          :class="{ active: currentPhase === 'pages' }"
+          @click="currentPhase = 'pages'"
+          :disabled="!generationStore.lastGenId"
+        >
+          📄 页面管理
+        </button>
+      </div>
+
+      <!-- ==================== 大纲阶段 ==================== -->
+      <div v-if="currentPhase === 'outline'" class="phase-panel">
+        <OutlineEditor
+          :session-id="intentStore.sessionId"
+          :intent-id="intentStore.intentId"
+          :intent-summary="intentStore.intentSummary"
+          :auto-restore="true"
+          @confirm-complete="handleOutlineConfirmed"
+          @outline-created="handleOutlineCreated"
+          @error="handleError"
+        />
+      </div>
+
+      <!-- ==================== 内容生成阶段 ==================== -->
+      <div v-else-if="currentPhase === 'generating'" class="phase-panel">
+        <!-- 生成控制栏 -->
+        <div class="gen-control-bar">
+          <div class="gen-info">
+            <span class="gen-label">大纲</span>
+            <span class="gen-value"
+              >{{ outlineStore.outline_id }} v{{
+                outlineStore.outline_version
+              }}</span
+            >
+            <span class="gen-label" style="margin-left: 12px">生成模式</span>
+            <select v-model="generateMode" class="gen-mode-select">
+              <option value="page_incremental">逐页增量生成</option>
+              <option value="page_parallel">全页面并行生成</option>
+            </select>
+          </div>
+          <div class="gen-actions">
+            <button
+              class="btn btn-primary"
+              :disabled="generationStore.isGenerating"
+              @click="handleStartGeneration"
+            >
+              {{ generationStore.isGenerating ? "生成中..." : "🚀 开始生成" }}
+            </button>
+          </div>
+        </div>
+
+        <!-- 进度展示 -->
+        <div
+          v-if="
+            generationStore.isGenerating || generationStore.generateProgress > 0
+          "
+          class="gen-progress-panel"
+        >
+          <div class="progress-bar-wrap">
+            <div
+              class="progress-bar-fill"
+              :style="{ width: generationStore.generateProgress + '%' }"
+            ></div>
+          </div>
+          <div class="progress-text">
+            <span>{{ generationStore.generateProgress }}%</span>
+            <span>{{ generationStore.generateStageText }}</span>
+          </div>
+        </div>
+
+        <!-- 错误展示 -->
+        <div v-if="genError" class="error-bar" role="alert">{{ genError }}</div>
+
+        <!-- 生成的节点树预览 -->
+        <div
+          v-if="generationStore.currentScriptNodes.length > 0"
+          class="gen-nodes-preview"
+        >
+          <h4>已生成节点</h4>
+          <div class="nodes-summary">
+            <span
+              v-for="(node, i) in generationStore.currentScriptNodes"
+              :key="i"
+              class="node-chip"
+            >
+              {{ i + 1 }}.
+              {{ node.title || node.node_title || "节点" + (i + 1) }}
+            </span>
+          </div>
+        </div>
+
+        <!-- HTML5 预览区 -->
+        <div v-if="generationStore.previewHtml" class="preview-section">
+          <div class="preview-toolbar">
+            <span>📺 HTML5 预览</span>
+            <button class="btn btn-sm" @click="openPreviewWindow">
+              新窗口打开
+            </button>
+          </div>
+          <iframe
+            v-if="previewFrameSrc"
+            :src="previewFrameSrc"
+            class="preview-frame"
+            sandbox="allow-scripts allow-same-origin"
+            title="课件预览"
+          ></iframe>
+          <div v-else class="preview-placeholder">
+            预览将在生成完成后自动加载
+          </div>
+        </div>
+
+        <!-- 无参考资料提示 -->
+        <div v-if="!hasEvidence" class="no-evidence-hint">
+          ⚠️ 当前无参考资料，内容将基于 S1 意图自动生成。
+          <router-link :to="{ name: 'S2Material' }"
+            >前往 S2 补充资料</router-link
+          >
+        </div>
+
+        <!-- 生成完成后操作 -->
+        <div
+          v-if="generationStore.generateProgress === 100"
+          class="gen-complete-actions"
+        >
+          <button class="btn btn-outline" @click="currentPhase = 'pages'">
+            管理生成页面
+          </button>
+          <button class="btn btn-primary" @click="goToS4">
+            下一步：版本管理 →
+          </button>
+        </div>
+      </div>
+
+      <!-- ==================== 页面管理阶段 ==================== -->
+      <div v-else-if="currentPhase === 'pages'" class="phase-panel">
+        <div class="pages-control-bar">
+          <div class="pages-info">
+            <span>Generation ID：{{ generationStore.lastGenId }}</span>
+          </div>
+          <div class="pages-actions">
+            <button class="btn btn-sm" @click="loadGenerationStatus">
+              🔄 刷新状态
+            </button>
+          </div>
+        </div>
+
+        <!-- 页面列表 -->
+        <div v-if="generationPages.length > 0" class="pages-list">
+          <div
+            v-for="page in generationPages"
+            :key="page.page_id"
+            class="page-item"
+            :class="`page-status-${page.status}`"
+          >
+            <div class="page-item-left">
+              <span class="page-order">第 {{ page.page_order }} 页</span>
+              <span class="page-node">关联节点：{{ page.node_id }}</span>
+            </div>
+            <div class="page-item-right">
+              <span class="page-status-badge">{{
+                statusLabel(page.status)
+              }}</span>
+              <button
+                v-if="page.status === 'failed'"
+                class="btn btn-sm"
+                :disabled="regeneratingPageId === page.page_id"
+                @click="handleRegeneratePage(page)"
+              >
+                {{
+                  regeneratingPageId === page.page_id
+                    ? "重生成中..."
+                    : "🔄 重试"
+                }}
+              </button>
+              <button
+                v-if="page.status === 'done'"
+                class="btn btn-sm"
+                @click="handlePreviewPage(page)"
+              >
+                👁 预览
+              </button>
+            </div>
+          </div>
+        </div>
+
+        <div v-else class="pages-empty">暂无页面数据，请先生成内容</div>
+
+        <!-- 互动资源入口 -->
+        <div v-if="generationStore.lastGenId" class="interactive-section">
+          <h4>🎮 互动资源管理</h4>
+          <p class="interactive-hint">
+            从大纲中标记为互动的节点可在此生成 HTML5 互动资源
+          </p>
+          <div class="interactive-node-list">
+            <div
+              v-for="node in interactiveNodes"
+              :key="node.node_id"
+              class="interactive-node-row"
+            >
+              <div class="int-node-info">
+                <span class="int-node-title">{{ node.title }}</span>
+                <span class="int-node-type">{{ node.node_type }}</span>
+              </div>
+              <div class="int-node-actions">
+                <template v-if="interactiveStore.hasAsset(node.node_id)">
+                  <span class="asset-done">✅ 已生成</span>
+                  <button
+                    class="btn btn-sm"
+                    @click="openInteractiveAsset(node)"
+                  >
+                    打开
+                  </button>
+                </template>
+                <template
+                  v-else-if="
+                    interactiveStore.getAsset(node.node_id)?.status ===
+                    'processing'
+                  "
+                >
+                  <span class="asset-pending">⏳ 生成中...</span>
+                </template>
+                <template v-else>
+                  <button
+                    class="btn btn-sm btn-primary"
+                    :disabled="interactiveStore.loading"
+                    @click="handleGenerateInteractive(node)"
+                  >
+                    生成互动
+                  </button>
+                </template>
+              </div>
+            </div>
+            <p v-if="interactiveNodes.length === 0" class="no-interactive-hint">
+              大纲中无互动节点，可在编辑大纲时将节点类型改为"互动环节"
+            </p>
+          </div>
+        </div>
+      </div>
+    </div>
+  </AppShell>
+</template>
+
+<script setup>
+import { ref, computed, onMounted, watch } from "vue";
+import AppShell from "../components/layout/AppShell.vue";
+import OutlineEditor from "../components/teacher/OutlineEditor.vue";
+import { useGenerationStore } from "../stores/generationStore";
+import { useOutlineStore } from "../stores/outlineStore";
+import { useInteractiveStore } from "../stores/interactiveStore";
+import { useIntentStore } from "../stores/intentStore";
+import { teacherV1Api } from "../services/v1";
+import { API_BASE, AI_API_BASE } from "../config/api";
+
+const generationStore = useGenerationStore();
+const outlineStore = useOutlineStore();
+const interactiveStore = useInteractiveStore();
+const intentStore = useIntentStore();
+
+// 阶段：outline | generating | pages
+const currentPhase = ref("outline");
+const generationMode = ref("");
+const generateMode = ref("page_incremental");
+const genError = ref("");
+const generationPages = ref([]);
+const regeneratingPageId = ref("");
+const previewFrameSrc = ref("");
+
+// 是否有参考资料
+const hasEvidence = computed(() => {
+  try {
+    const raw = window.localStorage.getItem("fuww_s2_evidence_packet");
+    return !!raw;
+  } catch {
+    return false;
+  }
+});
+
+// 需要互动资源的节点（大纲中标记为 interactive / quiz 的节点）
+const interactiveNodes = computed(() =>
+  (outlineStore.nodes || []).filter(
+    (n) => n.node_type === "interactive" || n.node_type === "quiz",
+  ),
+);
+
+onMounted(async () => {
+  // 恢复 S1 会话/意图（刷新或直接进入 S3 时 store 内存为空，
+  // 不恢复会导致 sessionId 缺失 → AI 生成大纲被 "缺少 session_id" 拦截）
+  intentStore.initialize();
+  if (typeof window !== "undefined") {
+    generationMode.value =
+      window.localStorage.getItem(
+        `fuww_s2_generation_mode:${intentStore.sessionId}`,
+      ) || "";
+  }
+  // 尝试从 localStorage 恢复大纲
+  const restored = outlineStore.restore();
+  if (restored && outlineStore.isConfirmed) {
+    currentPhase.value = "generating";
+  }
+  // 恢复最近生成记录
+  generationStore.restoreLastGenId();
+  if (generationStore.lastGenId) {
+    interactiveStore.setGenerationId(generationStore.lastGenId);
+    await loadGenerationStatus();
+  }
+});
+
+function statusLabel(status) {
+  return (
+    {
+      pending: "等待",
+      processing: "生成中",
+      done: "完成",
+      failed: "失败",
+    }[status] || status
+  );
+}
+
+// 大纲创建完成
+function handleOutlineCreated({ outline_id, outline_version }) {
+  console.log(
+    "[S3StudioPage] 大纲创建完成:",
+    outline_id,
+    "v" + outline_version,
+  );
+}
+
+// 大纲确认完成，进入生成阶段
+function handleOutlineConfirmed() {
+  currentPhase.value = "generating";
+}
+
+// 开始生成内容
+async function handleStartGeneration() {
+  if (!outlineStore.outline_id || !outlineStore.isConfirmed) {
+    handleError("请先确认大纲");
+    return;
+  }
+  genError.value = "";
+  generationStore.setGenerating(true);
+  generationStore.setGenerateProgress(5, "准备生成环境");
+
+  try {
+    let evidence = null;
+    try {
+      const raw = window.localStorage.getItem("fuww_s2_evidence_packet");
+      if (raw) evidence = JSON.parse(raw);
+    } catch {}
+
+    generationStore.setGenerateProgress(15, "创建生成任务");
+    const resp = await teacherV1Api.generation.createGeneration({
+      session_id: intentStore.sessionId,
+      outline_id: outlineStore.outline_id,
+      outline_version: outlineStore.outline_version,
+      outline_confirmed: true,
+      template_id: "default",
+      generate_mode: generateMode.value,
+      intent: intentStore.intentSummary || undefined,
+      evidence_packet: evidence,
+    });
+
+    const task = resp?.data || resp || {};
+    const taskId = task.task_id || task.generation_id;
+    if (!taskId) throw new Error("未返回生成任务 ID");
+    generationStore.setLastTaskId(taskId);
+
+    // 记录 generation_id
+    const genId = task.generation_id || taskId;
+    generationStore.setLastGenId(genId);
+    interactiveStore.setGenerationId(genId);
+
+    generationStore.setGenerateProgress(25, "正在生成内容");
+    const status = await generationStore.waitForCoursewareGeneration(taskId, {
+      intervalMs: 800,
+      maxAttempts: 300,
+    });
+
+    // 加载生成状态（页面列表）
+    await loadGenerationStatus();
+
+    // 渲染预览
+    generationStore.setGenerateProgress(92, "正在加载预览");
+    const html = await generationStore.renderCoursewarePreview(
+      outlineStore.title || intentStore.intentSummary?.topic || "课件预览",
+      { genId },
+    );
+    if (html) {
+      previewFrameSrc.value = `data:text/html;charset=utf-8,${encodeURIComponent(html)}`;
+    }
+
+    generationStore.setGenerateProgress(100, "生成完成");
+  } catch (err) {
+    genError.value = err?.message || "生成失败，请重试";
+    generationStore.setGenerateProgress(0, "生成失败");
+  } finally {
+    generationStore.setGenerating(false);
+  }
+}
+
+// 加载生成状态
+async function loadGenerationStatus() {
+  const taskId = generationStore.lastTaskId || generationStore.restoreLastTaskId();
+  if (!taskId) return;
+  try {
+    const resp = await teacherV1Api.generation.getGenerationStatus(taskId);
+    const data = resp?.data || resp || {};
+    generationPages.value = (Array.isArray(data.nodes) ? data.nodes : []).map((node, index) => ({
+      ...node,
+      page_id: node.page_id || node.node_id || `page_${index + 1}`,
+      page_order: Number(node.page_order || node.order || index + 1),
+      status: node.status || 'completed'
+    }));
+  } catch (err) {
+    console.warn("[S3StudioPage] 加载生成状态失败", err);
+  }
+}
+
+// 单页重生成
+async function handleRegeneratePage(page) {
+  regeneratingPageId.value = page.page_id;
+  try {
+    await teacherV1Api.generation.regeneratePage(
+      generationStore.lastGenId,
+      page.page_id,
+      { reason: "教师手动重试", mode: "ai" },
+    );
+    await loadGenerationStatus();
+  } catch (err) {
+    handleError("重生成失败: " + (err?.message || ""));
+  } finally {
+    regeneratingPageId.value = "";
+  }
+}
+
+// 预览单页
+async function handlePreviewPage(page) {
+  try {
+    const resp = await teacherV1Api.generation.getPage(
+      generationStore.lastGenId,
+      page.page_id,
+    );
+    const data = resp?.data || resp || {};
+    if (data.preview_url) {
+      window.open(data.preview_url, "_blank");
+    }
+  } catch (err) {
+    handleError("预览加载失败");
+  }
+}
+
+// 生成互动资源
+async function handleGenerateInteractive(node) {
+  if (!generationStore.lastGenId) return;
+  try {
+    await interactiveStore.generateInteractive({
+      generation_id: generationStore.lastGenId,
+      node_id: node.node_id,
+      interactive_plan: node.interactive_plan || {
+        enabled: true,
+        kind: "quiz",
+        question_count: 3,
+        duration_minutes: 5,
+        auto_grading: true,
+        delivery: "html5_link",
+      },
+    });
+    await interactiveStore.pollAssetStatus(node.node_id);
+  } catch (err) {
+    handleError("生成互动资源失败: " + (err?.message || ""));
+  }
+}
+
+// 打开互动资源
+function openInteractiveAsset(node) {
+  const asset = interactiveStore.getAsset(node.node_id);
+  if (asset?.entry_url) {
+    window.open(asset.entry_url, "_blank");
+  }
+}
+
+// 新窗口打开 HTML5 预览
+function openPreviewWindow() {
+  if (!generationStore.previewHtml) return;
+  const blob = new Blob([generationStore.previewHtml], { type: "text/html" });
+  const url = URL.createObjectURL(blob);
+  window.open(url, "_blank");
+  setTimeout(() => URL.revokeObjectURL(url), 10000);
+}
+
+function goToS4() {
+  // 同步大纲信息到 localStorage，供 S4 使用
+  try {
+    window.localStorage.setItem(
+      "fuww_s3_outline_info",
+      JSON.stringify({
+        outline_id: outlineStore.outline_id,
+        outline_version: outlineStore.outline_version,
+        generation_id: generationStore.lastGenId,
+      }),
+    );
+  } catch {}
+  import("vue-router").then(({ useRouter }) => {
+    const router = useRouter();
+    router.push({ name: "S4Version" });
+  });
+}
+
+function handleError(msg) {
+  genError.value = msg;
+  console.warn("[S3StudioPage]", msg);
+}
+</script>
+
+<style scoped>
+.s3-page {
+  display: flex;
+  flex-direction: column;
+  padding: 20px;
+  min-height: calc(100vh - 140px);
+  overflow: hidden;
+  background:
+    radial-gradient(
+      circle at 86% -15%,
+      rgba(175, 221, 203, 0.2),
+      transparent 30%
+    ),
+    linear-gradient(180deg, #fcfefd 0%, #f7faf8 100%);
+}
+.page-header {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 14px;
+}
+.page-header h2 {
+  margin: 0;
+  font-size: 22px;
+  color: #111827;
+}
+.page-header p {
+  margin: 6px 0 0;
+  font-size: 14px;
+  color: #607a71;
+}
+.page-header-right {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+}
+.page-body {
+  flex: 1;
+}
+.evidence-warning {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+  margin-bottom: 14px;
+  padding: 13px 16px;
+  border: 1px solid #f0d5a8;
+  border-radius: 12px;
+  background: #fffaf0;
+  color: #7c4a15;
+}
+.evidence-warning div {
+  display: flex;
+  align-items: baseline;
+  gap: 10px;
+  min-width: 0;
+}
+.evidence-warning strong {
+  flex-shrink: 0;
+  font-size: 13px;
+}
+.evidence-warning span {
+  font-size: 12px;
+  line-height: 1.55;
+  color: #8a6337;
+}
+.evidence-warning a {
+  flex-shrink: 0;
+  color: #2f605a;
+  font-size: 12px;
+  font-weight: 700;
+  text-decoration: none;
+}
+
+/* 阶段选项卡 */
+.phase-tabs {
+  display: flex;
+  gap: 4px;
+  margin-bottom: 14px;
+  border-bottom: 2px solid #e2ece6;
+}
+.phase-tab {
+  padding: 8px 18px;
+  border: none;
+  background: none;
+  font-size: 13px;
+  font-weight: 500;
+  color: #607a71;
+  cursor: pointer;
+  border-bottom: 2px solid transparent;
+  margin-bottom: -2px;
+  transition: all 0.15s;
+}
+.phase-tab:hover:not(:disabled) {
+  color: #2f605a;
+}
+.phase-tab.active {
+  color: #2f605a;
+  border-bottom-color: #2f605a;
+}
+.phase-tab:disabled {
+  opacity: 0.4;
+  cursor: not-allowed;
+}
+
+/* 阶段面板 */
+.phase-panel {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+
+/* 生成控制栏 */
+.gen-control-bar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 10px;
+  padding: 12px 16px;
+  background: #f8fbf9;
+  border: 1px solid #e4ede8;
+  border-radius: 12px;
+}
+.gen-info {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 13px;
+  flex-wrap: wrap;
+}
+.gen-label {
+  font-weight: 600;
+  color: #2f605a;
+}
+.gen-value {
+  color: #475569;
+}
+.gen-mode-select {
+  padding: 4px 8px;
+  border: 1px solid #c6ded6;
+  border-radius: 6px;
+  font-size: 12px;
+  color: #2f605a;
+  background: #fff;
+  outline: none;
+  cursor: pointer;
+}
+.gen-actions {
+  display: flex;
+  gap: 8px;
+}
+
+/* 进度条 */
+.gen-progress-panel {
+  padding: 12px 16px;
+  background: #f8fbf9;
+  border: 1px solid #e4ede8;
+  border-radius: 12px;
+}
+.progress-bar-wrap {
+  height: 8px;
+  background: #e2ece6;
+  border-radius: 999px;
+  overflow: hidden;
+  margin-bottom: 8px;
+}
+.progress-bar-fill {
+  height: 100%;
+  background: #2f605a;
+  border-radius: 999px;
+  transition: width 0.4s ease;
+}
+.progress-text {
+  display: flex;
+  justify-content: space-between;
+  font-size: 12px;
+  color: #607a71;
+}
+
+/* 错误条 */
+.error-bar {
+  padding: 10px 14px;
+  background: #fef2f2;
+  border: 1px solid #fecaca;
+  border-radius: 8px;
+  color: #dc2626;
+  font-size: 13px;
+}
+
+/* 节点预览 */
+.gen-nodes-preview {
+  padding: 12px 16px;
+  background: #f8fbf9;
+  border: 1px solid #e4ede8;
+  border-radius: 12px;
+}
+.gen-nodes-preview h4 {
+  margin: 0 0 8px;
+  font-size: 13px;
+  color: #2f605a;
+}
+.nodes-summary {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+.node-chip {
+  font-size: 12px;
+  background: #e8f5f0;
+  color: #2f605a;
+  padding: 3px 10px;
+  border-radius: 999px;
+}
+
+/* 预览区 */
+.preview-section {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.preview-toolbar {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  font-size: 13px;
+  color: #2f605a;
+  font-weight: 600;
+}
+.preview-frame {
+  width: 100%;
+  height: 480px;
+  border: 1px solid #e2ece6;
+  border-radius: 12px;
+  background: #fff;
+}
+.preview-placeholder {
+  height: 200px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px dashed #c6ded6;
+  border-radius: 12px;
+  color: #94a3b8;
+  font-size: 13px;
+}
+
+/* 无资料提示 */
+.no-evidence-hint {
+  font-size: 12px;
+  color: #7c4a15;
+  background: #fffaf0;
+  border: 1px solid #f0d5a8;
+  border-radius: 8px;
+  padding: 10px 14px;
+}
+.no-evidence-hint a {
+  color: #2f605a;
+  font-weight: 600;
+}
+
+/* 生成完成操作 */
+.gen-complete-actions {
+  display: flex;
+  gap: 10px;
+  justify-content: flex-end;
+}
+
+/* 页面管理 */
+.pages-control-bar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 10px;
+  padding: 10px 14px;
+  background: #f8fbf9;
+  border: 1px solid #e4ede8;
+  border-radius: 12px;
+}
+.pages-info {
+  font-size: 13px;
+  color: #475569;
+}
+.pages-list {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.page-item {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 8px;
+  padding: 10px 14px;
+  background: #fff;
+  border: 1.5px solid #e2ece6;
+  border-radius: 10px;
+}
+.page-status-done {
+  border-color: #6ee7b7;
+}
+.page-status-failed {
+  border-color: #fca5a5;
+}
+.page-status-processing {
+  border-color: #fcd34d;
+}
+.page-item-left {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  font-size: 13px;
+}
+.page-order {
+  font-weight: 600;
+  color: #2f605a;
+}
+.page-node {
+  color: #64748b;
+  font-size: 12px;
+}
+.page-item-right {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.page-status-badge {
+  font-size: 11px;
+  padding: 2px 8px;
+  border-radius: 999px;
+  font-weight: 600;
+}
+.page-status-done .page-status-badge {
+  background: #d1fae5;
+  color: #065f46;
+}
+.page-status-failed .page-status-badge {
+  background: #fee2e2;
+  color: #991b1b;
+}
+.page-status-processing .page-status-badge {
+  background: #fef9c3;
+  color: #854d0e;
+}
+.page-status-pending .page-status-badge {
+  background: #f3f4f6;
+  color: #6b7280;
+}
+.pages-empty {
+  text-align: center;
+  padding: 40px;
+  color: #94a3b8;
+  font-size: 13px;
+}
+
+/* 互动资源 */
+.interactive-section {
+  padding: 14px 16px;
+  background: #fff;
+  border: 1px solid #e4ede8;
+  border-radius: 12px;
+}
+.interactive-section h4 {
+  margin: 0 0 6px;
+  font-size: 14px;
+  color: #1e293b;
+}
+.interactive-hint {
+  margin: 0 0 12px;
+  font-size: 12px;
+  color: #64748b;
+}
+.interactive-node-list {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.interactive-node-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 8px;
+  padding: 8px 12px;
+  background: #f8fbf9;
+  border-radius: 8px;
+}
+.int-node-info {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.int-node-title {
+  font-size: 13px;
+  color: #1e293b;
+}
+.int-node-type {
+  font-size: 11px;
+  background: #e8f5f0;
+  color: #2f605a;
+  padding: 1px 6px;
+  border-radius: 999px;
+}
+.int-node-actions {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+.asset-done {
+  font-size: 12px;
+  color: #065f46;
+}
+.asset-pending {
+  font-size: 12px;
+  color: #854d0e;
+}
+.no-interactive-hint {
+  font-size: 12px;
+  color: #94a3b8;
+  text-align: center;
+  padding: 10px 0;
+}
+
+/* 通用按钮 */
+.btn {
+  padding: 6px 14px;
+  border-radius: 8px;
+  cursor: pointer;
+  font-size: 13px;
+  font-weight: 500;
+  transition: all 0.15s;
+  border: 1px solid transparent;
+}
+.btn-sm {
+  padding: 5px 12px;
+  font-size: 12px;
+}
+.btn-outline {
+  background: #fff;
+  border-color: #c6ded6;
+  color: #2f605a;
+}
+.btn-outline:hover {
+  background: #f0f5f2;
+}
+.btn-primary {
+  background: #2f605a;
+  color: #fff;
+}
+.btn-primary:hover:not(:disabled) {
+  background: #1e4a44;
+}
+.btn-primary:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+.btn:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+/* 步骤导航 */
+.step-pills {
+  display: flex;
+  gap: 6px;
+  flex-wrap: wrap;
+}
+.pill {
+  font-size: 12px;
+  font-weight: 600;
+  color: #5f7467;
+  background: #f0f5f2;
+  border: 1px solid #e2ece6;
+  border-radius: 999px;
+  padding: 6px 14px;
+  text-decoration: none;
+  transition: all 0.15s;
+}
+.pill:hover {
+  border-color: #5ca68f;
+  color: #2f605a;
+}
+.pill.active {
+  color: #fff;
+  background: #2f605a;
+  border-color: #2f605a;
+}
+
+@media (max-width: 760px) {
+  .page-header {
+    flex-direction: column;
+  }
+  .gen-control-bar {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+  .phase-tabs {
+    overflow-x: auto;
+  }
+}
+.pill.back-pill {
+  background: #e8f0ed;
+  border-color: #c6d9d0;
+  color: #3d6b60;
+}
+.pill.back-pill:hover {
+  background: #d6e8e0;
+}
+</style>
