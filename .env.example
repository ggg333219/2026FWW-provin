# ==============================================================================
# 泛雅 AI 智课系统 环境变量示例文件 (.env.example)
# ==============================================================================
# 说明：
# 1. 复制本文件为 .env 以供 Docker Compose 和 后端使用。
# 2. 如果需本机私有配置（如不同的 IP 或 API Key），请创建 .env.local 覆盖。
# 3. 后端配置优先级：系统变量 > .env.local > .env > YAML 文件。
#
# ⚠️ 密钥安全（务必阅读）：
#   - 本文件是「模板」，只会写占位符，绝不能填真实密钥后提交。
#   - 真实 AI_API_KEY / ANTHROPIC_AUTH_TOKEN 等请只写入 .env.local（已被 .gitignore 忽略）。
#   - .env / .env.local / backend/config/config.local.yaml 均不入库；
#     若误将密钥提交过，请立即到平台吊销重置（改历史也救不回已泄露的 key）。

# ------------------------------------------------------------------------------
# 1. AI 接口配置 (AI Engine / LLM Provider)
# ------------------------------------------------------------------------------
AI_API_KEY=sk-your-key-here
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=gpt-4o
# 生成模式: mock (本地模拟) | llm (调用接口)
AI_GEN_MODE=llm
# LLM 单次调用超时秒数（H1 三层超时统一：引擎 60s×2 次尝试 < Go 网关 90s < 前端 90s）
LLM_TIMEOUT_SECONDS=60
# Go 后端访问 AI 引擎的地址（H9：此前误用 AI_BASE_URL 指向 LLM 供应商）。
# 本机直跑默认 http://127.0.0.1:8000；Docker Compose 内用 http://ai-engine:8000。
AI_ENGINE_BASE_URL=http://127.0.0.1:8000

# 嵌入模型配置 (KB 知识库 RAG 使用)
AI_EMBEDDING_MODEL=text-embedding-v3
AI_EMBEDDING_DIM=512

# ------------------------------------------------------------------------------
# 2. 数据库配置 (Postgres)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=teaching
DB_SSLMODE=disable

# RAG 向量存储：完整环境使用 PostgreSQL/pgvector，避免重启丢失索引。
RAG_STORE_BACKEND=pgvector

# Docker / Compose: postgres container variables (用于 compose 启动，保持与 POSTGRES_* 对应)
POSTGRES_DB=teaching
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_PORT=15432

# ------------------------------------------------------------------------------
# 3. 缓存配置 (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# 4. 对象存储配置 (MinIO / OSS)
# ------------------------------------------------------------------------------
# 如果是在 Docker Compose 中连接，且 MinIO 网络别名为 minio，则用 minio:9000
# 如果是宿主机运行后端，则通常用 localhost:9000
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=teaching
MINIO_USE_SSL=false

# MinIO 控制台/API 端口（用于 docker-compose 端口映射）
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ------------------------------------------------------------------------------
# 5. 后端 Server 配置
# ------------------------------------------------------------------------------
SERVER_PORT=18080
SERVER_MODE=debug
LOG_LEVEL=info
