PUBLIC_ORIGIN=http://124.221.190.67
HTTP_PORT=80

POSTGRES_DB=teaching
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_CONSOLE_PORT=19001

# 未完成阶段默认 mock；准备好真实模型后改为 llm 并填写 Key。
AI_GEN_MODE=mock
AI_API_KEY=
AI_BASE_URL=https://api.x5m5x.com/v1
AI_MODEL=deepseek-v4-flash-0731

# ---- 语音输入（ASR）----
# 云端优先：配了 DASHSCOPE_API_KEY（或复用 AI_API_KEY）走阿里云 Paraformer。
# 云端不可用/失败时自动落到本地模型，因此建议两处都准备：
DASHSCOPE_API_KEY=
ASR_ALLOW_LOCAL_WHISPER=1          # 1 启用本地模型；0 禁用；留空=装了 faster-whisper 就自动启用
ASR_WHISPER_MODEL=tiny             # 本地模型大小（tiny 最小、CPU 可跑）
HF_ENDPOINT=https://hf-mirror.com  # 本地模型下载走镜像，避免卡在 huggingface.co

# ---- 本地知识库自动灌入 ----
# 引擎启动时自动把目录里的资料灌进知识库（灌入在后台跑，失败不影响启动）：
KB_AUTO_BOOTSTRAP=1                # 懒人模式：等效 KB_AUTO_INGEST_DIR=docs/knowledge
# KB_AUTO_INGEST_DIR=docs/knowledge;/opt/a12teaching/data/course-packs   # 多个目录用 ; 分隔
KB_DEFAULT_KNOWLEDGE_BASE_ID=kb_auto
# 需要灌入项目目录之外的资料时，显式放行（多个用 ; 分隔），避免接口被当成任意读文件口子：
# KB_INGEST_ALLOWED_ROOTS=/opt/a12teaching/data/course-packs
