FROM docker.m.daocloud.io/library/golang:1.25.1-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=off
RUN go mod download
COPY cmd/teacher ./cmd/teacher
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o teacher-server ./cmd/teacher

FROM docker.m.daocloud.io/library/alpine:3.19
RUN apk --no-cache add ca-certificates poppler-utils
WORKDIR /app
ENV A12_PROJECT_ROOT=/app
COPY --from=builder /app/teacher-server .
COPY --from=builder /app/internal/database/migrations ./internal/database/migrations
COPY config/config.docker.yaml ./config/config.yaml
EXPOSE 18080
CMD ["./teacher-server"]
