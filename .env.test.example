# 测试环境变量示例。
# 复制为 .env.test 后，再执行：
# docker compose --env-file .env.test -f docker-compose.test.yml up -d --build

POSTGRES_DB=teaching_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_PORT=25432

REDIS_PORT=26379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001
MINIO_BUCKET=teaching-test

AI_ENGINE_PORT=28000
AI_GEN_MODE=mock
AI_BASE_URL=http://ai-engine:8000
AI_ENGINE_BASE_URL=http://ai-engine:8000
AI_API_KEY=

BACKEND_PORT=28080

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=teaching_test
DB_SSLMODE=disable

REDIS_HOST=redis
REDIS_DB=0
REDIS_PASSWORD=

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

SERVER_PORT=18080
SERVER_MODE=release
LOG_LEVEL=info